# Copy to .env (git-ignored) and adjust. Restart `npm start` after changing it.
#
# Base URL of the booking REST API (see src/api/bookingApi.js). Leave unset to use
# the mock in public/api.js.
#
# WARNING: every REACT_APP_* variable is bundled into the public JavaScript.
# Only put NON-secret values here (a public URL). Never API keys or tokens.
REACT_APP_API_BASE_URL=https://api.example.com
